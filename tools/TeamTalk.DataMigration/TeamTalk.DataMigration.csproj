<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TeamTalk.Infrastructure\TeamTalk.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only this standalone tool needs to talk to the retired SQL Server source; the
         main Infrastructure project references Npgsql only after the migration. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

</Project>
